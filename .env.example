ANTHROPIC_API_KEY=sk-ant-...

# LINE Messaging API (ใช้แทน LINE Notify ที่ปิดแล้ว)
LINE_CHANNEL_TOKEN=...ใส่ channel access token
LINE_USER_ID=...ใส่ user ID ที่จะส่งข้อความ
LINE_NOTIFY_ENABLED=false   # ปิดระหว่าง backtest

GOOGLE_SHEETS_ID=...ใส่ Sheets ID จริง
GOOGLE_CREDENTIALS_JSON=./credentials.json
SHEETS_ENABLED=false        # ปิดระหว่าง backtest

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

TV_USERNAME=
TV_PASSWORD=

ACCOUNT_BALANCE=10000
RISK_PCT=1.5

# Lot-base portfolio: the fixed notional lot sizing uses (budget = base × risk%).
# Leave empty to use ACCOUNT_BALANCE. Set to pin lots to a chosen value
# regardless of ACCOUNT_BALANCE (e.g. 1000 to match the MaiRuay v2 golden).
# This is a fixed operator-set value — NOT the live broker equity.
LOT_BASE_PORTFOLIO=

# Execution Quality Logger — บันทึก slippage / rejection / fill-time / spread
# ลง logs/execution/exec_YYYY-MM.jsonl (แยกจาก trade log) เพื่อสร้าง baseline
# ตรวจจับการเปลี่ยนพฤติกรรมโบรกเกอร์. Backtest ไม่ log (ไม่มี execution จริง).
EXECUTION_LOG_ENABLED=true
EXECUTION_LOG_DIR=logs/execution
